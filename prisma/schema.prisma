generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  password          String
  role              Role      @default(USER)
  resetOtp          String?
  resetOtpExpiresAt DateTime?
  // রিলেশন: একজন অর্গানাইজার একাধিক ইভেন্ট তৈরি করতে পারে
  events            Event[]
  // রিলেশন: একজন ইউজার একাধিক ইভেন্টে রেজিস্টার করতে পারে
  registrations     Registration[]
  // রিলেশন: একজন ইউজারের ফেভারিট / বুকমার্ক করা ইভেন্টসমূহ
  favorites         Favorite[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}
model Event {
  id             String      @id @default(uuid())
  title          String
  description    String      @db.Text
  bannerImage    String?     // কার্ডের ছবির লিংক
  date           DateTime    // ইভেন্ট শুরুর তারিখ ও সময়
  endDate        DateTime?   // ইভেন্ট শেষের তারিখ ও সময়
  location       String      // ভেন্যু বা মিটিং লিংক
  category       String      // Technology, Music, Business, etc.
  eventType      EventType   @default(IN_PERSON)
  ticketPrice    Float       @default(0.0)
  totalSeats     Int         // মোট আসন
  availableSeats Int         // অবশিষ্ট আসন (যেমন: 498 seats left)
  isFeatured     Boolean     @default(false) // Featured events সেকশনের জন্য
  status         EventStatus @default(PENDING)
  // রিলেশন: কোন অর্গানাইজার ইভেন্টটি তৈরি করেছে
  organizerId    String
  organizer      User        @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  // রিলেশন: ইভেন্টের সমস্ত রেজিস্ট্রেশন
  registrations  Registration[]
  // রিলেশন: ইভেন্টটির ফেভারিট কাউন্ট / তালিকা
  favorites      Favorite[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

enum Role {
  USER
  ADMIN
  ORGANIZER
}

enum EventType {
  IN_PERSON
  ONLINE
}

enum EventStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  CANCELLED
  COMPLETED
}

model Registration {
  id        String             @id @default(uuid())
  status    RegistrationStatus @default(CONFIRMED)
  
  // কোন ইউজার বুক করেছে
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // কোন ইভেন্ট বুক করা হয়েছে
  eventId   String
  event     Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  // 💡 গুরুত্বপূর্ণ: একই ইউজার যেন একই ইভেন্টে দুইবার রেজিস্টার করতে না পারে
  @@unique([userId, eventId])
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
}

model Favorite {
  id        String   @id @default(uuid())

  // কোন ইউজার ফেভারিট করেছে
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // কোন ইভেন্ট ফেভারিট করা হয়েছে
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // 💡 গুরুত্বপূর্ণ: একই ইউজার একই ইভেন্ট একবারই ফেভারিট করতে পারবে
  @@unique([userId, eventId])
}


