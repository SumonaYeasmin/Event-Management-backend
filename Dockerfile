# ==============================================================================
# ১. আগের সিঙ্গেল-স্টেজ কোড (কমেন্ট করে রাখা হলো)
# ==============================================================================
# # ১. নোডের লাইটওয়েট অ্যালপাইন ইমেজ 
# FROM node:20-alpine
# 
# # ২. Alpine-এ Prisma চালানোর জন্য OpenSSL প্রয়োজন
# RUN apk add --no-cache openssl
# 
# # ৩. কন্টেইনারের ভেতরের ফোল্ডার
# WORKDIR /app
# 
# # ৪. প্যাকেজ ফাইল কপি ও ইন্সটল
# COPY package*.json ./
# RUN npm install
# 
# # ৫. প্রজেক্টের সব কোড কপি
# COPY . .
# 
# # ৬. Prisma ক্লায়েন্ট জেনারেট করা
# RUN npx prisma generate
# 
# # ৭. অ্যাপ্লিকেশনের পোর্ট
# EXPOSE 5000
# 
# # ৮. সার্ভার স্টার্ট কমান্ড
# CMD ["npm", "run", "dev"]


# ==============================================================================
# ২. নতুন: মাল্টি-স্টেজ বিল্ড (Multi-stage Build) - প্রোডাকশন অপ্টিমাইজড
# ==============================================================================

# ------------------------------------------------------------------------------
# 🏗️ স্টেজ ১: বিল্ডার (Builder Stage)
# কাজ: টাইপস্ক্রিপ্ট কোড কম্পাইল করা ও প্রোডাকশন 'dist' ফোল্ডার তৈরি করা
# ------------------------------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app

# প্রিজমা ইঞ্জিনের জন্য প্রয়োজনীয় লাইব্রেরি
RUN apk add --no-cache openssl

# প্যাকেজ লিস্ট কপি
COPY package*.json ./

# বিল্ড করার জন্য devDependencies সহ সব প্যাকেজ দরকার (npm install দিয়ে lockfile mismatch এড়ানো হয়েছে)
RUN npm install

# পুরো প্রজেক্ট কোড কপি
COPY . .

# প্রিজমা ক্লায়েন্ট তৈরি করা (src/generated ফোল্ডারে কোড তৈরি হবে)
RUN npx prisma generate

# NestJS সোর্স কোড কম্পাইল করে 'dist' ফোল্ডার তৈরি
RUN npm run build


# ------------------------------------------------------------------------------
# 🚀 স্টেজ ২: রানার (Runner Stage)
# কাজ: শুধুমাত্র তৈরি হওয়া 'dist' চালিয়ে অ্যাপ লাইভ রাখা (কোনো অতিরিক্ত ফাইল থাকবে না)
# ------------------------------------------------------------------------------
FROM node:22-alpine AS runner

WORKDIR /app

RUN apk add --no-cache openssl

# পরিবেশকে প্রোডাকশন মোডে সেট করা
ENV NODE_ENV=production

# শুধু প্যাকেজ ফাইল কপি
COPY package*.json ./

# 💡 ম্যাজিক লাইন: শুধুমাত্র প্রোডাকশন প্যাকেজ ইনস্টল হবে (ভারী devDependencies বাদ!)
RUN npm install --omit=dev

# বিল্ডার (স্টেজ ১) থেকে শুধু কম্পাইল হওয়া 'dist' ফোল্ডারটি কপি করে আনা
COPY --from=builder /app/dist ./dist

# প্রিজমা স্কিমা কপি করে রাখা
COPY --from=builder /app/prisma ./prisma

# পোর্ট এক্সপোজ
EXPOSE 5000

# প্রোডাকশন বিল্ড রান করা
CMD ["node", "dist/main.js"]
